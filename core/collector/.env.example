# -----------------------------------------------------------------------
# Part 2 — Central Collector API
# -----------------------------------------------------------------------

# Authentication keys for each honeypot node.
# Use strong random secrets in production; never commit the real .env file.
NODE_KEYS_JSON={"node-01":"change-me-node-01","node-02":"change-me-node-02","node-03":"change-me-node-03"}

# Maximum events accepted in a single POST /api/events request.
MAX_BATCH_SIZE=20

# How often (in seconds) the collector runs the housekeeping pass:
#   - mark_stale_nodes_offline()
#   - close_stale_sessions()
# Baseline heartbeat interval is 60s, so 60s here is a sensible default.
MAINTENANCE_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------
# Shared database — the `common` package owns this file; the collector, the
# enricher, the alert engine and the dashboard must all point at the SAME
# path so they share one database.
# -----------------------------------------------------------------------
# Absolute path to the shared SQLite database.
# Default (when unset): common/src/common/honeypot_aggregator.db
HONEYPOT_DB_PATH=/opt/tiadh/honeypot_aggregator.db

# Nothing else is needed to reach the storage layer: `common` is an installed
# dependency (see requirements.txt), not a directory located at runtime.
