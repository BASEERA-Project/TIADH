# Part 4 configuration. Copy to .env, then:  set -a; . ./.env; set +a
#
# .env is gitignored. No secrets belong in here anyway — node keys are Part 2's
# responsibility, not Part 4's.

# --- Paths ----------------------------------------------------------------
# All five parts must point at the SAME file. Keep it on local disk;
# SQLite over a network share corrupts.
HONEYPOT_DB_PATH=./honeypot_aggregator.db
HONEYPOT_EXPORT_DIR=./exports

# --- Contract -------------------------------------------------------------
KNOWN_NODES=node-01,node-02,node-03
STRICT_NODE_IDS=1          # 0 to accept ad-hoc node IDs during a demo

# --- Database -------------------------------------------------------------
SQLITE_BUSY_TIMEOUT_MS=5000
NODE_OFFLINE_AFTER_SECONDS=180     # three missed 60s heartbeats
SESSION_STALE_AFTER_SECONDS=3600

# --- Alerting -------------------------------------------------------------
ALERT_WINDOW_MINUTES=5
BRUTE_FORCE_THRESHOLD=5
CREDENTIAL_SPRAY_THRESHOLD=5
HIGH_RISK_SCORE_THRESHOLD=75
MULTI_NODE_SCAN_THRESHOLD=2
ALERT_COOLDOWN_MINUTES=30
ENABLED_RULES=brute_force,high_risk_ip,suspicious_command,malware_staging,credential_spray,multi_node_scan,post_auth_activity

# --- Feed export ----------------------------------------------------------
FEED_MIN_SEVERITY=medium
FEED_STATUSES=open,acknowledged
FEED_PRODUCER=Distributed Honeypot TI Aggregator
