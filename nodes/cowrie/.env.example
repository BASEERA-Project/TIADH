# =========================================================================
# TIADH — configuration for a SENSOR HOST
#
#   cp .env.example .env              # then: uv run adapter.py
#
# adapter.py loads this file itself, by name, from the directory it lives in.
# Nothing needs sourcing. A real environment variable still outranks the file,
# so `NODE_KEY=... uv run adapter.py` overrides one value for one run.
#
# The aggregator's own settings live in the repository-root .env, which this
# node never reads: adapter.py names this file explicitly rather than searching
# upwards, so a sensor cannot pick up the aggregator's configuration by
# accident. There is no overlap between the two beyond the values that have to
# agree, noted below.
# =========================================================================

# This node's ID. Must be listed in the aggregator's KNOWN_NODES, or the
# collector rejects every event. One value per sensor: node-01, node-02, ...
NODE_ID=node-02

# Shared key for this node. Must match this node's entry in the aggregator's
# NODE_KEYS_JSON (.env.secrets), or the collector answers 401.
NODE_KEY=change-me-node-02

# The real collector's ingest endpoint. Port 8000.
# nodes/cowrie/stub_server.py listens on 5000 instead, for testing the adapter
# without an aggregator.
COLLECTOR_URL=http://<aggregator-host>:8000/api/events

# Where docker-compose.yml mounts Cowrie's JSON log. The default is relative,
# so it only resolves if adapter.py is run one level below the compose file —
# set an absolute path to stop worrying about the working directory.
LOG_PATH=../cowrie-logs/cowrie.json

# The user the Cowrie container runs as. It has to be able to write to the
# cowrie-logs/ and cowrie-data/ directories on this host, so it must be the
# account that owns them — otherwise Cowrie dies at startup on "Permission
# denied ... var/lib/cowrie/uuid". Only set these if `id -u` isn't 1000; this
# pair is read by docker-compose.yml, not by adapter.py.
# COWRIE_UID=1000
# COWRIE_GID=1000
