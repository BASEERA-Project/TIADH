# =========================================================================
# TIADH — configuration for a SENSOR HOST
#
#   cp .env.example .env              # then: uv run adapter.py
#
# adapter.py loads this file itself, by name, from the directory it lives in.
# Nothing needs sourcing. A real environment variable still outranks the file,
# so `NODE_KEY=... uv run adapter.py` overrides one value for one run.
#
# The aggregator's own settings live in the repository-root .env, which this
# node never reads: adapter.py names this file explicitly rather than searching
# upwards, so a sensor cannot pick up the aggregator's configuration by
# accident. There is no overlap between the two beyond the values that have to
# agree, noted below.
# =========================================================================

# This node's ID. Must be listed in the aggregator's KNOWN_NODES, or the
# collector rejects every event. One value per sensor: node-01, node-02, ...
NODE_ID=node-02

# Shared key for this node. Must match this node's entry in the aggregator's
# NODE_KEYS_JSON (.env.secrets), or the collector answers 401.
NODE_KEY=change-me-node-02

# The real collector's ingest endpoint. The host is the aggregator's address on
# this network, and the port is its COLLECTOR_PORT (the aggregator's own .env),
# 8000 unless someone changed it there.
# nodes/cowrie/stub_server.py listens on 5000 instead, for testing the adapter
# without an aggregator.
COLLECTOR_URL=http://<aggregator-host>:8000/api/events

# Where docker-compose.yml mounts Cowrie's JSON log. This path is relative, so
# it only resolves if adapter.py is run from the directory holding the compose
# file — set an absolute path to stop worrying about the working directory.
# Name the live cowrie.json, never one of the rotated cowrie.json.YYYY-MM-DD
# files: adapter.py follows the rotation on its own, by this name.
LOG_PATH=./cowrie-logs/cowrie.json

# -------------------------------------------------------------------------
# Timing. All in seconds, all optional — the values shown are the defaults, and
# a sensor that sets none of them behaves as it always has. Anything that isn't
# a positive number is refused at startup, with a line saying so, and the
# default is kept.
# -------------------------------------------------------------------------

# How long the tailer waits before looking at cowrie.json again when it has
# nothing new, and so how quickly it notices a rotation.
# POLL_INTERVAL_SECONDS=1

# How often this node sends a heartbeat. NOT a local preference: it is a
# Baseline v1.3 contract value, and the aggregator marks this node offline
# after three missed beats (NODE_OFFLINE_AFTER_SECONDS, which it derives from
# its own HEARTBEAT_INTERVAL_SECONDS). Change it here and change it there too,
# or this node flaps offline between beats.
# HEARTBEAT_INTERVAL_SECONDS=60

# How long a partly-filled batch waits before being sent anyway. A batch that
# reaches 20 events is sent the moment it does, whatever this says.
# BATCH_INTERVAL_SECONDS=10

# How often events spooled to pending_events.jsonl by a failed send are
# retried. Lower it if the link to the aggregator is flaky.
# RETRY_INTERVAL_SECONDS=30

# The user the Cowrie container runs as. It has to be able to write to the
# cowrie-logs/ and cowrie-data/ directories on this host, so it must be the
# account that owns them — otherwise Cowrie dies at startup on "Permission
# denied ... var/lib/cowrie/uuid". Only set these if `id -u` isn't 1000; this
# pair is read by docker-compose.yml, not by adapter.py.
# COWRIE_UID=1000
# COWRIE_GID=1000
