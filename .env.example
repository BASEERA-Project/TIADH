# =========================================================================
# TIADH — configuration for the AGGREGATOR HOST
#
#   cp .env.example .env
#
# That is the whole setup step. `common/config.py` loads this file on import,
# so every part on this host — collector, enricher, alert/export cycle and
# dashboard — reads it without anything being exported or sourced.
#
# A real environment variable always wins over this file, so `--db`, Docker's
# `environment:` block and CI overrides still take precedence.
#
# Secrets are NOT here. Node keys and the dashboard signing key live in
# `.env.secrets` — see `.env.secrets.example`.
#
# The sensor hosts are separate machines and keep their own file:
# `nodes/cowrie/.env.example`.
#
# Syntax: KEY=value, one per line. Values are read as data, not shell, so
# spaces and JSON braces are safe unquoted. An unquoted value may end with a
# ` # comment`; quote the value if it genuinely contains one.
# =========================================================================

# --- Paths ---------------------------------------------------------------
# Both aggregator commands must resolve to the SAME database file. Leaving
# this unset is the safe choice: the default lives inside the installed
# `common` package, which is one absolute path shared by every part.
#
# If you do set it, make it ABSOLUTE. A relative path resolves against each
# process's working directory, so `./honeypot_aggregator.db` silently gives
# core/ and dashboard/ two different databases.
# Keep it on local disk — SQLite over NFS/SMB corrupts.
#HONEYPOT_DB_PATH=/opt/tiadh/honeypot_aggregator.db
#HONEYPOT_EXPORT_DIR=/opt/tiadh/exports

# --- Contract (Baseline v1.3) --------------------------------------------
KNOWN_NODES=node-01,node-02,node-03
STRICT_NODE_IDS=1                  # 0 to accept ad-hoc node IDs during a demo
HEARTBEAT_INTERVAL_SECONDS=60      # contract value; the offline timeout derives from it

# --- Database ------------------------------------------------------------
SQLITE_BUSY_TIMEOUT_MS=5000
#NODE_OFFLINE_AFTER_SECONDS=180    # defaults to 3 x HEARTBEAT_INTERVAL_SECONDS
SESSION_STALE_AFTER_SECONDS=3600

# --- Collector (ingest API) ----------------------------------------------
# Where the collector listens for node events. 0.0.0.0 on purpose, and the
# opposite of DASHBOARD_HOST below: the sensors are on other machines, so
# binding this to loopback makes the collector unreachable to every one of
# them. Narrow it to one interface (e.g. the lab NIC's address) rather than to
# 127.0.0.1 if you want to limit where events can arrive from.
#
# The port has to agree with COLLECTOR_URL on each sensor
# (nodes/cowrie/.env) — that is the same number written from the other end.
# `main.py serve --host/--port` overrides both for a single run.
COLLECTOR_HOST=0.0.0.0
COLLECTOR_PORT=8000
MAX_BATCH_SIZE=20                  # max events per POST /api/events
MAINTENANCE_INTERVAL_SECONDS=60    # stale-node + stale-session sweep

# --- Enrichment ----------------------------------------------------------
# The enricher geolocates via ip-api.com and scores via AbuseIPDB. The API key
# is a secret and lives in .env.secrets; without it, abuse_score stays NULL and
# geolocation plus the local profile score carry on regardless.
ABUSEIPDB_MAX_AGE_DAYS=90          # complaint lookback window, max 365

# --- Alerting ------------------------------------------------------------
ALERT_WINDOW_MINUTES=5
BRUTE_FORCE_THRESHOLD=5
CREDENTIAL_SPRAY_THRESHOLD=5
HIGH_RISK_SCORE_THRESHOLD=75
MULTI_NODE_SCAN_THRESHOLD=2
ALERT_COOLDOWN_MINUTES=30
ENABLED_RULES=brute_force,high_risk_ip,suspicious_command,malware_staging,credential_spray,multi_node_scan,post_auth_activity

# --- Feed export ---------------------------------------------------------
FEED_MIN_SEVERITY=medium
FEED_STATUSES=open,acknowledged
FEED_PRODUCER=Distributed Honeypot TI Aggregator

# --- Dashboard -----------------------------------------------------------
# Binds loopback on purpose: this page renders attacker IPs, session
# transcripts and the outbound feed. Set DASHBOARD_SECRET_KEY in
# .env.secrets before changing DASHBOARD_HOST.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
DASHBOARD_ALLOW_ALERT_ACTIONS=1    # 0 for a strictly read-only deployment
DASHBOARD_REFRESH_SECONDS=30       # 0 disables auto-refresh
DASHBOARD_PAGE_SIZE=50
DASHBOARD_ACTIVITY_HOURS=24
DASHBOARD_HEARTBEAT_WARN_MISSED=2  # amber past this many missed heartbeats
DASHBOARD_HEARTBEAT_CRIT_MISSED=5  # red past this many

# Where each sensor sits, for the destination end of the Map screen. This is
# configuration rather than data because Baseline v1.3 froze the `nodes` table
# without coordinates. Format: node_id:lat,lon — semicolons between entries. A
# node left out is named under the map as unplaced, never guessed at; attacker
# origins are geolocated by the enricher and need nothing here.
#DASHBOARD_NODE_COORDS=node-01:24.7136,46.6753; node-02:52.3676,4.9041
#DASHBOARD_MAP_MAX_ORIGINS=150     # marks drawn before the map reports a remainder
#DASHBOARD_MAP_MAX_ARCS=200        # origin-to-sensor paths drawn
DASHBOARD_APP_NAME=TIADH
DASHBOARD_APP_SUBTITLE=Distributed Honeypot Threat Intelligence
#DASHBOARD_TEMPLATE_RELOAD=0       # --debug sets this for you
