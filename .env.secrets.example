# =========================================================================
# TIADH — secrets for the AGGREGATOR HOST
#
#   cp .env.secrets.example .env.secrets
#
# Loaded by `common/config.py` immediately after `.env`, from the same
# directory. Split out so `.env` stays a committable-looking template and
# this file is the only one you have to treat as sensitive.
#
# `.env.secrets` is gitignored and excluded from Docker build contexts. In
# Docker, pass these through compose `environment:` / a secrets manager
# instead — a real environment variable outranks this file.
# =========================================================================

# Collector authentication: node-id -> shared key. A node whose key is not in
# here is rejected with 401, so this map and the sensors' NODE_KEY values must
# agree. Replace every value before this leaves a lab.
NODE_KEYS_JSON={"node-01":"change-me-node-01","node-02":"change-me-node-02","node-03":"change-me-node-03"}

# Flask session/CSRF signing key for the dashboard. Required before exposing
# the dashboard on anything but loopback. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SECRET_KEY=change-me-before-exposing-the-dashboard
